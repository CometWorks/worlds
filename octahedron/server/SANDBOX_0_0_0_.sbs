bool fillBottles = true;
string[] lockedContainerKeywords = {
	"Locked",
	"Control Station",
	"Control Seat",
	"Safe Zone",
	"Gatling Turret",
	"Rocket Turret",
	"Artillery Turret",
	"Assault Cannon Turret",
	"Autocannon Turret",
	"Interior Turret"
};

bool balanceTypeContainers = true;
bool showFillLevel = false;
bool fillBottles = true;
string[] lockedContainerKeywords = {
	"Locked",
	"Control Station",
	"Control Seat",
	"Safe Zone",
	"Gatling Turret",
	"Rocket Turret",
	"Artillery Turret",
	"Assault Cannon Turret",
	"Autocannon Turret",
	"Interior Turret"
};
string[] hiddenContainerKeywords = {
	"Hidden",
	"Gatling Turret",
	"Rocket Turret",
	"Artillery Turret",
	"Assault Cannon Turret",
	"Autocannon Turret",
	"Interior Turret"
};


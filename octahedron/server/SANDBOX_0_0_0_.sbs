          <NumberInGrid>3</NumberInGrid>
          <Enabled>true</Enabled>
          <Program>/*
 * Isy's Inventory Manager
 * ===================
 * Version: 2.9.5-rglx
 * Date: 2023-12-10
 * 
 * Guide: http://steamcommunity.com/sharedfiles/filedetails/?id=1226261795
 * 
 * THIS COPY OF IIM HAS BEEN MODIFIED AND IS NOT FOR DISTRIBUTION UNDER ANY CIRCUMSTANCE.
 * YOU DEFINITELY SHOULD NOT HAVE THIS FILE.
 * 
 * Extent of modifications:
 * - special containers will no longer be considered a valid source for learning about new items
 * 	- this breaks the non-documented functionality of teaching different instances of IIM about items via special containers
 * - items that do not have blueprints associated with them will not be stored in the block's CustomData
 * 	- this breaks the 'show unlearned items' functionality
 */

// CONFIGURATION (rglx's special pre-set config so she doesn't have to go through this every time IIM needs to be redeployed)
const string oreContainerKeyword = "Ores";
const string ingotContainerKeyword = "Ingots";
const string componentContainerKeyword = "Components";
const string toolContainerKeyword = "Tools";
const string ammoContainerKeyword = "Ammo";
const string bottleContainerKeyword = "Bottles";

bool treatNotShownAsHidden = false;
string noSortingKeyword = "[No Sorting]";
string noIIMKeyword = "[No IIM]";
bool balanceTypeContainers = true;
bool showFillLevel = false;
bool fillBottles = true;
string[] lockedContainerKeywords = {
	"Locked",
	"Control Station",
	"Control Seat",
	"Safe Zone",
	"Gatling Turret",
	"Rocket Turret",
	"Artillery Turret",
	"Assault Cannon Turret",
	"Autocannon Turret",
	"Interior Turret"
};
string[] hiddenContainerKeywords = {
	"Hidden",
	"Gatling Turret",
	"Rocket Turret",
	"Artillery Turret",
	"Assault Cannon Turret",
	"Autocannon Turret",
	"Interior Turret"
};

bool autoContainerAssignment = false;
bool assignNewContainers = true;
bool assignOres = true;
bool assignIngots = true;
bool assignComponents = false;
bool assignTools = false;
bool assignAmmo = true;
bool assignBottles = false;
bool unassignEmptyContainers = true;
bool unassignOres = true;
bool unassignIngots = true;
bool unassignComponents = false;
bool unassignTools = false;
bool unassignAmmo = true;
bool unassignBottles = false;
bool oresIngotsInOne = true;
bool toolsAmmoBottlesInOne = false;

bool enableAutocrafting = true;
bool enableAutodisassembling = true;
string autocraftingKeyword = "Station IIM Autocrafting Control";
string assembleKeyword = "!assemble-only";
string disassembleKeyword = "!disassemble-only";
string learnKeyword = "!learn";
string learnManyKeyword = "!learnMany";
string defaultModifier = "A";
double assembleMargin = 0;
double disassembleMargin = 0;

	"Parachute",
	"VendingMachine",
	"InteriorTurret",
	"LargeGatlingTurret",
	"LargeMissileTurret",
	"SmallGatlingGun",
	"SmallMissileLauncher",
	"SmallMissileLauncherReload"
};

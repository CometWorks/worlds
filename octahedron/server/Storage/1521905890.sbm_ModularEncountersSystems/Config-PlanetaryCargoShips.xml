<?xml version="1.0"?>
<ConfigPlanetaryCargoShips xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- Every node a player enters starts new spawn timers for that player, so the first spawn
       waits as long as the next ones do (default 300 s, which a node change would hand out again). -->
  <FirstSpawnTime>780</FirstSpawnTime>
  <!-- Cleanup tuned for the cluster (MES.md, "MES on a cluster"): every node runs its own MES and sees
       only its own players, so the nearest player is the nearest on the grid's node. Remove a grid
       after 900 s with no such player within 15 km; a player coming back within 15 km resets the
       timer. 15 km is far beyond what any client sees (sync distance 3 km), so no player sees a
       removal. The unpowered override is off: MES swaps its powered and unpowered values. -->
  <UseCleanupSettings>true</UseCleanupSettings>
  <CleanupUseDistance>true</CleanupUseDistance>
  <CleanupDistanceTrigger>15000</CleanupDistanceTrigger>
  <CleanupUseTimer>true</CleanupUseTimer>
  <CleanupDistanceStartsTimer>true</CleanupDistanceStartsTimer>
  <CleanupResetTimerWithinDistance>true</CleanupResetTimerWithinDistance>
  <CleanupTimerTrigger>900</CleanupTimerTrigger>
  <CleanupUnpoweredOverride>false</CleanupUnpoweredOverride>
</ConfigPlanetaryCargoShips>

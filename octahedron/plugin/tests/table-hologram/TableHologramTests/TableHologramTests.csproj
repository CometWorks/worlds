<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the plugin's SetNewBlueprint postfix from parallel threads, as the cluster's
       handover import does (SE-1230). Needs the dedicated server's assemblies, no game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>14</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../ServerPlugin/ServerPlugin.csproj" />
    <Reference Include="Sandbox.Game">
      <HintPath>$(Dedicated64Dir)Sandbox.Game.dll</HintPath>
    </Reference>
    <Reference Include="SpaceEngineers.Game">
      <HintPath>$(Dedicated64Dir)SpaceEngineers.Game.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Game">
      <HintPath>$(Dedicated64Dir)VRage.Game.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>

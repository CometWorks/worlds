<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Sounds>
    <!-- The filament tools at work (SE-1089): the thunder of Pertam's electric storm
         (the game's WM_Lightning waves), at the range of OmniArc's welding sound. The mod's
         script plays one wave after another while a tool works, the game picks which
         one, so the tools don't sound alike. Not looped: a wave plays to its end after
         the tool stops (SE-1116).
         make_octahedron_mod.py copies the waves from the game: a mod's sound can't point
         at the game's Content/Audio -->
    <Sound>
      <Id>
        <TypeId>MyObjectBuilder_AudioDefinition</TypeId>
        <SubtypeId>OctahedronFilamentStorm</SubtypeId>
      </Id>
      <Category>TOOL</Category>
      <MaxDistance>125</MaxDistance>
      <UpdateDistance>125</UpdateDistance>
      <Volume>0.6</Volume>
      <PitchVariation>100</PitchVariation>
      <Loopable>false</Loopable>
      <Waves>
        <Wave Type="D3">
          <Start>Audio\OctahedronMod\Lightning_0.wav</Start>
        </Wave>
        <Wave Type="D3">
          <Start>Audio\OctahedronMod\Lightning_1.wav</Start>
        </Wave>
        <Wave Type="D3">
          <Start>Audio\OctahedronMod\Lightning_2.wav</Start>
        </Wave>
        <Wave Type="D3">
          <Start>Audio\OctahedronMod\Lightning_3.wav</Start>
        </Wave>
      </Waves>
    </Sound>
  </Sounds>
</Definitions>

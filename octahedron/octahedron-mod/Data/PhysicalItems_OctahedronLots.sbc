<?xml version="1.0"?>
<!-- The rows of 1,000 kg lots in OCT's Stores (SE-1497). The Store screen takes a row's name, icon
     and unit from its item's definition, so the plugin shows a lot row to the clients as one of these
     items: "Silicon Ore (1 t)", counted in pieces, priced per lot. Nobody ever holds one: the Store
     trades the real item (StoreLots in the plugin). Not public, no blueprint, in no faction's store. -->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Components>
    <Component>
      <Id>
        <TypeId>Component</TypeId>
        <SubtypeId>OctahedronLot_Ore_Ice</SubtypeId>
      </Id>
      <DisplayName>Ice (1 t)</DisplayName>
      <Description>A lot of 1,000 kg of Ice, the way OCT's Stores trade it. The price is per lot; a purchase puts 1,000 kg of Ice into the inventory for each lot.</Description>
      <Icon>Textures\GUI\Icons\ore_H2O_ice.dds</Icon>
      <Model>Models\Components\Sphere.mwm</Model>
      <Size><X>0.5</X><Y>0.5</Y><Z>0.5</Z></Size>
      <Mass>1000</Mass>
      <Volume>370</Volume>
      <Public>false</Public>
      <MaxIntegrity>1</MaxIntegrity>
      <DropProbability>0</DropProbability>
    </Component>
    <Component>
      <Id>
        <TypeId>Component</TypeId>
        <SubtypeId>OctahedronLot_Ore_Stone</SubtypeId>
